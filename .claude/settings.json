{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tools/build.py)",
      "Bash(python3 -m http.server:*)",
      "Bash(node audit.mjs:*)",
      "Bash(node contrast.mjs:*)",
      "Bash(node lightbox.mjs:*)",
      "Bash(node compare.mjs:*)",
      "Bash(npm ci)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(./tools/set-domain.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
