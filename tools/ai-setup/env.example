# Settings for claude-routed. setup.sh copies this to ~/.config/claude-routed/env
# (chmod 600). Never commit the real file: it holds your OmniRoute key.

# From the OmniRoute dashboard → Endpoints. Claude Code sends it to OmniRoute
# (through Headroom) as a bearer token.
OMNIROUTE_API_KEY="paste-your-key-here"

# Where OmniRoute listens. The default is fine unless you changed its port.
OMNIROUTE_URL="http://127.0.0.1:20128"

# Headroom's local proxy port.
HEADROOM_PORT=8787

# Extra flags for `headroom wrap claude`, e.g. "--memory" or "--1m".
# Leave --memory off while claude-mem is installed: both inject memory.
HEADROOM_WRAP_FLAGS=""

# Telemetry. Both tools phone home anonymously by default; these turn it off.
export HEADROOM_BEACON=off
export CLAUDE_MEM_TELEMETRY=0
